// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favorites Favorite[]
}

model College {
  id              String     @id @default(uuid())
  name            String
  location        String
  fees            Int        // annual fee in INR
  rating          Float      // rating e.g. 4.5
  placements      Float      // average placements in LPA (e.g. 12.5)
  image           String
  description     String     @db.Text
  courses         Json       // array of strings e.g. ["B.Tech Computer Science", "B.Tech IT"]
  reviews         Json       // array of objects e.g. [{"author": "John", "rating": 4.5, "comment": "Good college"}]
  establishedYear Int
  type            String     // Public or Private
  accreditation   String     // NAAC A++, etc.
  website         String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  favoritedBy     Favorite[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}
